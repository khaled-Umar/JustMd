{
  "name": "justmd-editor-bundle",
  "version": "1.0.0",
  "private": true,
  "description": "Builds the vendored ProseMirror edit-mode bundle (src/JustMd/web/vendor/editor.bundle.js and editor.css).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "markdown-it": "$markdown-it"
  }
}
